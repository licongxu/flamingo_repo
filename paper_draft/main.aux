\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Same as Fig.~\ref {fig:scatter_fullsky} but for the masked spectra ($q_{\mathrm  {cat}} = 5$), with the conditional-moment covariance of Eqs.~\eqref  {eq:masked_trispec} and \eqref  {eq:covariance}. Every bin is statistically consistent with the Gaussian prediction, including the lowest multipoles, and the empirical means agree with the $\mathcal  {W}_2$-weighted theory of Eq.~\eqref  {eq:masked_ps} at the $\sim 1\sigma $ level.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:scatter_masked}{{3}{4}{Same as Fig.~\ref {fig:scatter_fullsky} but for the masked spectra ($q_{\mathrm {cat}} = 5$), with the conditional-moment covariance of Eqs.~\eqref {eq:masked_trispec} and \eqref {eq:covariance}. Every bin is statistically consistent with the Gaussian prediction, including the lowest multipoles, and the empirical means agree with the $\mathcal {W}_2$-weighted theory of Eq.~\eqref {eq:masked_ps} at the $\sim 1\sigma $ level}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Posterior constraints ($68\%$ and $95\%$ credible regions) from the three single probes on the synthetic signal-only sky: CNC, full-sky tSZ power spectrum, and masked tSZ power spectrum ($q_{\mathrm  {cat}} = 5$). Dashed lines mark the fiducial values. The full-sky spectrum constrains essentially the one-dimensional combination $F$ of Eq.~\eqref  {eq:F_def}; the CNC posterior is offset high in $\Omega _{\mathrm  {m}}$ by $+2.4\sigma $ (see text).}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:syn_single}{{4}{4}{Posterior constraints ($68\%$ and $95\%$ credible regions) from the three single probes on the synthetic signal-only sky: CNC, full-sky tSZ power spectrum, and masked tSZ power spectrum ($q_{\mathrm {cat}} = 5$). Dashed lines mark the fiducial values. The full-sky spectrum constrains essentially the one-dimensional combination $F$ of Eq.~\eqref {eq:F_def}; the CNC posterior is offset high in $\Omega _{\mathrm {m}}$ by $+2.4\sigma $ (see text)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Joint posteriors on the synthetic signal-only sky: CNC plus full-sky tSZ versus CNC plus masked tSZ. The masked combination is the tightest on every parameter and pulls the CNC-induced $\Omega _{\mathrm  {m}}$ offset back to $+0.5\sigma $.}}{5}{figure.5}\protected@file@percent }
\newlabel{fig:syn_joint}{{5}{5}{Joint posteriors on the synthetic signal-only sky: CNC plus full-sky tSZ versus CNC plus masked tSZ. The masked combination is the tightest on every parameter and pulls the CNC-induced $\Omega _{\mathrm {m}}$ offset back to $+0.5\sigma $}{figure.5}{}}
