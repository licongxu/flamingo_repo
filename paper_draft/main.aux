\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Joint correlation matrix of the data vector $[N_{\mathrm  {cl}}(z),\ C_\ell ]$ estimated from $192$ HEALPix $N_{\mathrm  {side}} = 4$ patches ($\sim 215\,\mathrm  {deg}^2$ each) of the fiducial L1\_m9 sky, for the full-sky spectrum (left) and the masked $q > 5$ spectrum (right). The redshift bins cover $0.005 < z < 0.6$ (counts at $q > 5$); the nine bandpowers span $\ell _{\mathrm  {eff}} = 117$ to $960$. Masking suppresses both the strong low-$\ell $ bandpower correlations (upper-right block) and the counts-bandpower cross block, whose mean falls from $+0.135$ to $+0.057$.}}{11}{figure.11}\protected@file@percent }
\newlabel{fig:corrmat}{{11}{11}{Joint correlation matrix of the data vector $[N_{\mathrm {cl}}(z),\ C_\ell ]$ estimated from $192$ HEALPix $N_{\mathrm {side}} = 4$ patches ($\sim 215\,\mathrm {deg}^2$ each) of the fiducial L1\_m9 sky, for the full-sky spectrum (left) and the masked $q > 5$ spectrum (right). The redshift bins cover $0.005 < z < 0.6$ (counts at $q > 5$); the nine bandpowers span $\ell _{\mathrm {eff}} = 117$ to $960$. Masking suppresses both the strong low-$\ell $ bandpower correlations (upper-right block) and the counts-bandpower cross block, whose mean falls from $+0.135$ to $+0.057$}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Correlation between the total cluster count $N_{\mathrm  {cl}}(q > 5)$ and each bandpower across the $192$ L1\_m9 patches. The grey band is the null expectation $\pm 1/\sqrt  {n_{\mathrm  {patch}}}$. Masking reduces the mean correlation from $+0.38$ (rising to $+0.56$ at $\ell _{\mathrm  {eff}} = 960$) to $+0.16$; the residual is patch-level large-scale-structure coupling through the two-halo term, and is absent ($+0.016$) in an unclustered painted Monte Carlo with the same selection.}}{11}{figure.12}\protected@file@percent }
\newlabel{fig:crosscorr}{{12}{11}{Correlation between the total cluster count $N_{\mathrm {cl}}(q > 5)$ and each bandpower across the $192$ L1\_m9 patches. The grey band is the null expectation $\pm 1/\sqrt {n_{\mathrm {patch}}}$. Masking reduces the mean correlation from $+0.38$ (rising to $+0.56$ at $\ell _{\mathrm {eff}} = 960$) to $+0.16$; the residual is patch-level large-scale-structure coupling through the two-halo term, and is absent ($+0.016$) in an unclustered painted Monte Carlo with the same selection}{figure.12}{}}
