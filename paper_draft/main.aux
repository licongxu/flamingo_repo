\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Ratio of the tSZ power spectrum in each L1\_m9 feedback variant to the fiducial run, for the full sky and after masking at $q_{\mathrm  {cat}} = 10$, $5$, and $1$. Line colour and style identify the variant (legend on top). The fractional feedback imprint survives masking essentially unchanged at high multipoles (relative full range $0.33$ at $\ell = 3000$ both before and after the $q_{\mathrm  {cat}} = 5$ mask), while the low-$\ell $ ratios become noisier as the surviving power is dominated by ever fewer objects.}}{10}{figure.10}\protected@file@percent }
\newlabel{fig:l1m9_feedback}{{10}{10}{Ratio of the tSZ power spectrum in each L1\_m9 feedback variant to the fiducial run, for the full sky and after masking at $q_{\mathrm {cat}} = 10$, $5$, and $1$. Line colour and style identify the variant (legend on top). The fractional feedback imprint survives masking essentially unchanged at high multipoles (relative full range $0.33$ at $\ell = 3000$ both before and after the $q_{\mathrm {cat}} = 5$ mask), while the low-$\ell $ ratios become noisier as the surviving power is dominated by ever fewer objects}{figure.10}{}}
