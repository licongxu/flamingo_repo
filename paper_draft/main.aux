\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces L2p8\_m9 tSZ power spectrum under progressive SNR masking. Colours denote the threshold (full sky and $q_{\mathrm  {cat}} = 50, 20, 10, 5$); within each colour, circles show the masked map bandpowers, solid lines the model-free catalogue summation of Eq.~\eqref  {eq:cat_sum} over the surviving haloes, dashed lines the completeness-weighted halo-model theory, and dotted lines the white plateau $C_{\mathrm  {white}} = \DOTSB \sum@ \slimits@ _{\mathrm  {surv}} Y_{\mathrm  {ang}}^2 / 4\pi $. The lower panel shows the ratio of each prediction to the map. The catalogue sum tracks the map to a median of $1.028$ over $400 < \ell < 6000$ (full sky); its low-$\ell $ deficit is the omitted two-halo term, which the halo-model theory (dashed) supplies.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:flamingo_snr}{{7}{7}{L2p8\_m9 tSZ power spectrum under progressive SNR masking. Colours denote the threshold (full sky and $q_{\mathrm {cat}} = 50, 20, 10, 5$); within each colour, circles show the masked map bandpowers, solid lines the model-free catalogue summation of Eq.~\eqref {eq:cat_sum} over the surviving haloes, dashed lines the completeness-weighted halo-model theory, and dotted lines the white plateau $C_{\mathrm {white}} = \sum _{\mathrm {surv}} Y_{\mathrm {ang}}^2 / 4\pi $. The lower panel shows the ratio of each prediction to the map. The catalogue sum tracks the map to a median of $1.028$ over $400 < \ell < 6000$ (full sky); its low-$\ell $ deficit is the omitted two-halo term, which the halo-model theory (dashed) supplies}{figure.7}{}}
